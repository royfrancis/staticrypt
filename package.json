{
    "name": "staticrypt",
    "version": "3.5.6",
    "description": "Password protect a static HTML file without a backend - StatiCrypt uses AES-256 with WebCrypto to encrypt your input with your long password and put it in a HTML file with a password prompt that can decrypted in-browser (client side).",
    "files": [
        "/cli",
        "/lib"
    ],
    "bin": {
        "staticrypt": "./cli/index.js"
    },
    "dependencies": {
        "dotenv": "^16.0.3",
        "yargs": ">=10.0.3 <=17.7.2"
    },
    "engines": {
        "node": ">=16.0.0"
    },
    "funding": {
        "type": "github",
        "url": "https://github.com/royfrancis/staticrypt"
    },
    "author": "Roy Francis (https://github.com/royfrancis)",
    "contributors": [
        "Robin Moisson (https://github.com/robinmoisson)",
        "Aaron Coplan (https://github.com/AaronCoplan)",
        "Adam Hull (https://github.com/hurrymaplelad)"
    ],
    "license": "MIT",
    "scripts": {
        "format": "prettier --write \"**/*.{js,json,html}\"",
        "test": "jest",
        "docs:dev": "vitepress dev docs",
        "docs:build": "vitepress build docs",
        "docs:preview": "vitepress preview docs"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/royfrancis/staticrypt.git"
    },
    "keywords": [
        "static",
        "html",
        "password",
        "protected",
        "encrypted",
        "encryption",
        "crypto",
        "webcrypto"
    ],
    "bugs": {
        "url": "https://github.com/royfrancis/staticrypt/issues"
    },
    "homepage": "https://github.com/royfrancis/staticrypt",
    "devDependencies": {
        "jest": "^29.7.0",
        "prettier": "^2.8.8",
        "vitepress": "^1.6.4"
    }
}
